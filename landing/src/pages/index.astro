---
import BaseLayout from '../layouts/BaseLayout.astro';

const repoUrl = 'https://github.com/howlil/chatspace';
const privacyUrl = `${repoUrl}/blob/master/PRIVACY.md`;
const securityUrl = `${repoUrl}/blob/master/SECURITY.md`;

const principles = [
  {
    eyebrow: 'Local-first',
    title: 'Your workspace stays in your browser.',
    copy: 'Folders, saved conversation references, notes, tabs, graph relations, and workspace state are owned by Chatspace locally—not by a new cloud account.',
  },
  {
    eyebrow: 'Provider boundary',
    title: 'ChatGPT stays the conversation runtime.',
    copy: 'Chatspace lives beside native ChatGPT in the Chromium Side Panel. Navigation is URL/tab based; the workspace does not need provider DOM scraping or private APIs.',
  },
  {
    eyebrow: 'Explicit sync',
    title: 'Markdown leaves only when you ask.',
    copy: 'Connect a local folder and manually write notes into a Chatspace directory. No localhost bridge, bearer token, background sync, or bidirectional magic.',
  },
];

const steps = [
  ['01', 'Save the useful thread', 'Keep a local reference to a supported ChatGPT conversation instead of turning the provider into a second file system.'],
  ['02', 'Curate what matters', 'Organize references and Markdown notes in a compact local hierarchy with tabs, tags, links, and keyboard navigation.'],
  ['03', 'See the relationships', 'Use the graph as a spatial navigation surface over your own workspace state, with explicit provenance for manual relations.'],
];
---

<BaseLayout
  title="Chatspace — a local workspace beside ChatGPT"
  description="Organize saved ChatGPT conversation references, Markdown notes, tabs, and local graph relationships in a compact Chromium Side Panel workspace."
>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Chatspace home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" />
          </svg>
        </span>
        <span>Chatspace</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#product">Product</a>
        <a href="#principles">Principles</a>
        <a href="#install">Install</a>
      </nav>

      <div class="header-actions">
        <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Use light theme" title="Use light theme">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5" />
            <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3 3.9 3.9M20.1 20.1l-1.4-1.4M18.7 5.3l1.4-1.4M3.9 20.1l1.4-1.4" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 15.2A8.3 8.3 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z" />
          </svg>
        </button>
        <a class="header-repo" href={repoUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.94a9.3 9.3 0 0 1 2.5.35c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Local-first Chromium workspace</div>
          <h1 id="hero-title">A workspace for the conversations worth keeping.</h1>
          <p class="hero-lede">
            Chatspace sits beside native ChatGPT and gives your work a durable local structure: saved conversation references, Markdown notes, tabs, and a graph—without turning the provider page into another dashboard.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={repoUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.94a9.3 9.3 0 0 1 2.5.35c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
              View source
            </a>
            <a class="button button-secondary" href="#product">
              See the workspace
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
          </div>
          <div class="hero-status" aria-label="Project status">
            <span class="status-label">Current status</span>
            <span class="status-value"><span class="status-pulse"></span> Development / daily-driver candidate</span>
          </div>
        </div>

        <div class="hero-product" aria-label="Illustration of Chatspace beside native ChatGPT">
          <div class="browser-frame">
            <div class="browser-chrome">
              <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="address-bar"><span class="lock-dot"></span> chatgpt.com</div>
              <div class="chrome-spacer"></div>
            </div>
            <div class="browser-body">
              <aside class="mock-side-panel">
                <div class="mock-appbar">
                  <div class="mock-brand"><span class="mock-brand-dot"></span> Chatspace</div>
                  <span class="mock-kbd">⌘K</span>
                </div>
                <div class="mock-workspace">
                  <div class="mock-explorer">
                    <div class="mock-search"><span></span><em>Search workspace</em></div>
                    <div class="mock-section-label">Pinned</div>
                    <div class="mock-tree-row active"><i class="tree-chat"></i><span>Architecture notes</span></div>
                    <div class="mock-tree-row"><i class="tree-chat"></i><span>Graph navigation</span></div>
                    <div class="mock-section-label with-rule">Workspace</div>
                    <div class="mock-tree-row folder"><i class="tree-folder"></i><span>Research</span><small>3</small></div>
                    <div class="mock-tree-row nested"><i class="tree-note"></i><span>Local-first design</span></div>
                    <div class="mock-tree-row folder"><i class="tree-folder"></i><span>Build</span><small>2</small></div>
                  </div>
                  <div class="mock-workbench">
                    <div class="mock-tabs">
                      <div class="mock-tab active">Local-first design</div>
                      <div class="mock-tab">Graph</div>
                    </div>
                    <div class="mock-editor">
                      <div class="editor-kicker">NOTE</div>
                      <div class="editor-title">Local-first design</div>
                      <div class="editor-meta"><span>#architecture</span><span>#privacy</span></div>
                      <div class="editor-rule"></div>
                      <div class="editor-line wide"></div>
                      <div class="editor-line mid"></div>
                      <div class="editor-line short"></div>
                      <div class="editor-callout">
                        <span class="callout-icon">↗</span>
                        <div><b>Linked conversation</b><small>Architecture notes</small></div>
                      </div>
                      <div class="editor-line wide muted"></div>
                      <div class="editor-line mid muted"></div>
                    </div>
                  </div>
                </div>
              </aside>
              <section class="mock-provider" aria-label="Native ChatGPT remains the main page">
                <div class="provider-top"><span class="provider-wordmark">ChatGPT</span><span class="provider-account"></span></div>
                <div class="provider-thread">
                  <div class="provider-message user"><span></span><span></span></div>
                  <div class="provider-message assistant"><i></i><div><span></span><span></span><span></span><span></span></div></div>
                  <div class="provider-message user second"><span></span></div>
                  <div class="provider-message assistant"><i></i><div><span></span><span></span><span></span></div></div>
                </div>
                <div class="provider-composer"><span>Ask anything</span><i></i></div>
                <div class="provider-label">Native ChatGPT</div>
              </section>
            </div>
          </div>
          <div class="product-caption">
            <span><i class="caption-dot accent"></i> Chatspace Side Panel</span>
            <span><i class="caption-dot neutral"></i> Provider-owned conversation surface</span>
          </div>
        </div>
      </section>

      <section class="signal-strip" aria-label="Core product boundaries">
        <div><span>01</span> Browser-local workspace state</div>
        <div><span>02</span> URL-only provider navigation</div>
        <div><span>03</span> No provider DOM scraping</div>
        <div><span>04</span> Manual Markdown sync</div>
      </section>

      <section class="product-section section" id="product" aria-labelledby="product-title">
        <div class="section-heading narrow-heading">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Product model</div>
          <h2 id="product-title">Keep the provider simple. Put structure around your work.</h2>
          <p>Chatspace does not replace the place where you talk to the model. It owns the local layer around those conversations: navigation, notes, context, and relationships.</p>
        </div>

        <div class="feature-stage feature-stage-notes">
          <div class="feature-copy">
            <span class="feature-index">01 / NOTES</span>
            <h3>Turn useful threads into durable knowledge.</h3>
            <p>Write Markdown beside the conversation, add local tags, link back to saved chats, and keep the result understandable without depending on provider content extraction.</p>
            <ul class="feature-list">
              <li>Markdown Edit / Preview</li>
              <li>Tags and linked chat references</li>
              <li>Related-local navigation from your own data</li>
            </ul>
          </div>
          <div class="note-demo" aria-hidden="true">
            <div class="demo-toolbar"><span>local-first-design.md</span><div><i></i><i></i></div></div>
            <div class="demo-note-body">
              <span class="demo-overline">ARCHITECTURE NOTE</span>
              <h4>Local-first design</h4>
              <div class="demo-tags"><span>architecture</span><span>privacy</span><span>workspace</span></div>
              <p>Keep canonical workspace state independent from provider content and make every integration boundary explicit.</p>
              <div class="demo-quote"><span>Provider boundary</span><strong>Validated URL / tab navigation only</strong></div>
              <div class="demo-linked"><i>↗</i><span><small>LINKED CHAT</small>Architecture notes</span><b>Open</b></div>
            </div>
          </div>
        </div>

        <div class="feature-stage feature-stage-graph">
          <div class="graph-demo" aria-hidden="true">
            <div class="graph-toolbar"><span>Graph</span><div><i></i><i></i><i></i></div></div>
            <svg class="graph-canvas" viewBox="0 0 620 390" fill="none" preserveAspectRatio="xMidYMid meet">
              <path class="graph-edge reference" d="M119 196C185 196 205 112 273 112" />
              <path class="graph-edge reference" d="M119 196C185 196 203 274 273 274" />
              <path class="graph-edge manual" d="M348 112C414 112 420 193 492 193" />
              <path class="graph-edge manual" d="M348 274C416 274 420 193 492 193" />
              <g class="graph-node workspace"><rect x="48" y="166" width="142" height="60" rx="12" /><circle cx="72" cy="196" r="6" /><text x="88" y="192">Workspace</text><text class="node-meta" x="88" y="208">local root</text></g>
              <g class="graph-node note"><rect x="246" y="81" width="152" height="62" rx="12" /><circle cx="270" cy="112" r="6" /><text x="286" y="108">Local-first design</text><text class="node-meta" x="286" y="124">note</text></g>
              <g class="graph-node chat"><rect x="246" y="243" width="152" height="62" rx="12" /><circle cx="270" cy="274" r="6" /><text x="286" y="270">Architecture notes</text><text class="node-meta" x="286" y="286">chat reference</text></g>
              <g class="graph-node selected"><rect x="464" y="160" width="128" height="66" rx="12" /><circle cx="488" cy="193" r="6" /><text x="504" y="189">Privacy model</text><text class="node-meta" x="504" y="205">note</text></g>
            </svg>
            <div class="graph-legend"><span><i class="legend-reference"></i> Reference</span><span><i class="legend-manual"></i> Manual relation</span></div>
          </div>
          <div class="feature-copy">
            <span class="feature-index">02 / GRAPH</span>
            <h3>See relationships without pretending the model invented them.</h3>
            <p>The graph is a projection over canonical local workspace state. Manual relations stay explicit, derived layout stays derived, and relationship provenance remains visible.</p>
            <ul class="feature-list">
              <li>Pan, zoom, fit, search, and focus</li>
              <li>Manual relations with provenance</li>
              <li>No opaque AI-generated graph edges</li>
            </ul>
          </div>
        </div>

        <div class="feature-stage feature-stage-sync">
          <div class="feature-copy">
            <span class="feature-index">03 / MARKDOWN SYNC</span>
            <h3>Your notes can become ordinary files.</h3>
            <p>Select a local folder and explicitly sync the active note beneath <code>Chatspace/</code>. The connection is local, manual, one-way, and does not require a companion server.</p>
            <ul class="feature-list">
              <li>Direct selected-folder access</li>
              <li>No localhost bridge or bearer token</li>
              <li>Workspace export remains separate from the folder handle</li>
            </ul>
          </div>
          <div class="sync-demo" aria-hidden="true">
            <div class="sync-path"><span>Selected folder</span><strong>Knowledge Vault</strong><i>Connected</i></div>
            <div class="sync-flow">
              <div class="sync-source"><small>ACTIVE NOTE</small><b>Local-first design</b><span>1.8 KB Markdown</span></div>
              <div class="sync-arrow"><span>Manual sync</span><i>→</i></div>
              <div class="sync-target"><small>LOCAL FILE</small><b>Chatspace/local-first-design.md</b><span>Written on request</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="principles-section section" id="principles" aria-labelledby="principles-title">
        <div class="section-heading split-heading">
          <div>
            <div class="eyebrow"><span class="eyebrow-dot"></span> Product boundaries</div>
            <h2 id="principles-title">Local-first is a boundary, not a badge.</h2>
          </div>
          <p>The product is intentionally narrower than an all-in-one AI client. That constraint keeps ownership clear and lets the native provider experience remain untouched.</p>
        </div>

        <div class="principles-list">
          {principles.map((principle, index) => (
            <article class="principle-row">
              <span class="principle-number">0{index + 1}</span>
              <div class="principle-body">
                <span class="principle-eyebrow">{principle.eyebrow}</span>
                <h3>{principle.title}</h3>
                <p>{principle.copy}</p>
              </div>
              <span class="principle-mark" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="workflow-section section" aria-labelledby="workflow-title">
        <div class="section-heading narrow-heading">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Daily flow</div>
          <h2 id="workflow-title">From conversation to something you can return to.</h2>
        </div>
        <ol class="workflow-list">
          {steps.map(([number, title, copy]) => (
            <li>
              <span class="workflow-number">{number}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="trust-section section" aria-labelledby="trust-title">
        <div class="trust-panel">
          <div class="trust-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> Trust model</div>
            <h2 id="trust-title">The useful thing about the boundary is that you can explain it.</h2>
            <p>Chatspace keeps provider integration deliberately small. Your local workspace can keep working even when the provider is unavailable, because the provider does not own the workspace.</p>
            <div class="trust-links">
              <a href={privacyUrl} target="_blank" rel="noreferrer">Read privacy model <span>↗</span></a>
              <a href={securityUrl} target="_blank" rel="noreferrer">Read security policy <span>↗</span></a>
            </div>
          </div>
          <div class="boundary-table" role="table" aria-label="Chatspace trust boundaries">
            <div class="boundary-row boundary-head" role="row"><span role="columnheader">Boundary</span><span role="columnheader">Current behavior</span></div>
            <div class="boundary-row" role="row"><span role="cell">Conversation content</span><strong role="cell">Provider-owned</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Workspace state</span><strong role="cell">Extension-local</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Provider navigation</span><strong role="cell">Validated URL / tab</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Provider DOM scraping</span><strong role="cell">Not used</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Markdown sync</span><strong role="cell">Manual / one-way</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Cloud account</span><strong role="cell">Not required</strong></div>
          </div>
        </div>
      </section>

      <section class="install-section section" id="install" aria-labelledby="install-title">
        <div class="install-grid">
          <div class="install-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> Built in public</div>
            <h2 id="install-title">Run it from source.</h2>
            <p>Chatspace is currently a development / daily-driver candidate, not a store-ready release. Clone the repository, build the Chromium extension, and load the generated output locally.</p>
            <a class="button button-primary" href={repoUrl} target="_blank" rel="noreferrer">Explore the repository <span>↗</span></a>
            <p class="license-note">Source is publicly available on GitHub. The repository does not currently declare an OSS license, so this page intentionally does not claim a specific open-source license.</p>
          </div>
          <div class="code-window">
            <div class="code-titlebar"><span>Install from source</span><div><i></i><i></i><i></i></div></div>
            <pre><code><span class="code-comment"># Requirements: Node 22.12+ and pnpm 11.23.0</span>
<span class="code-prompt">$</span> git clone https://github.com/howlil/chatspace.git
<span class="code-prompt">$</span> cd chatspace
<span class="code-prompt">$</span> pnpm install --frozen-lockfile
<span class="code-prompt">$</span> pnpm build

<span class="code-comment"># Then load the generated extension from .output/
# using Chromium's “Load unpacked”.</span></code></pre>
          </div>
        </div>
      </section>

      <section class="closing-section" aria-labelledby="closing-title">
        <div class="closing-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" /></svg>
        </div>
        <h2 id="closing-title">Keep the conversation native.<br />Make the workspace yours.</h2>
        <div class="closing-actions">
          <a class="button button-primary" href={repoUrl} target="_blank" rel="noreferrer">View Chatspace on GitHub <span>↗</span></a>
          <a class="text-link" href="#top">Back to top <span>↑</span></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand"><span class="brand-mark mini" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" /></svg></span><span>Chatspace</span></div>
      <p>Local-first workspace beside native ChatGPT.</p>
      <nav aria-label="Footer navigation">
        <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={privacyUrl} target="_blank" rel="noreferrer">Privacy</a>
        <a href={securityUrl} target="_blank" rel="noreferrer">Security</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

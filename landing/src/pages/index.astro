---
import BaseLayout from '../layouts/BaseLayout.astro';

const repoUrl = 'https://github.com/howlil/chatspace';
const privacyUrl = `${repoUrl}/blob/master/PRIVACY.md`;
const securityUrl = `${repoUrl}/blob/master/SECURITY.md`;

const steps = [
  ['01', 'Open a long ChatGPT conversation', 'Chatspace detects the active rendered conversation in the browser tab.'],
  ['02', 'Read the map', 'See turns in a spatial graph, search the live conversation, and focus the region that matters.'],
  ['03', 'Jump back to source', 'Select a turn to scroll the native ChatGPT message into view.'],
];
---

<BaseLayout
  title="Chatspace — navigate long ChatGPT conversations spatially"
  description="A local-first Chromium Side Panel that maps rendered ChatGPT conversations, focuses discussion threads, and jumps back to source messages."
>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Chatspace home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" />
          </svg>
        </span>
        <span>Chatspace</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#features">Features</a>
        <a href="#boundaries">Boundaries</a>
        <a href="#install">Install</a>
      </nav>

      <div class="header-actions">
        <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Use light theme" title="Use light theme">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5" />
            <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3 3.9 3.9M20.1 20.1l-1.4-1.4M18.7 5.3l1.4-1.4M3.9 20.1l1.4-1.4" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 15.2A8.3 8.3 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z" />
          </svg>
        </button>
        <a class="header-repo" href={repoUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.94a9.3 9.3 0 0 1 2.5.35c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Chromium Side Panel · local-first</div>
          <h1 id="hero-title">Navigate long ChatGPT conversations spatially.</h1>
          <p class="hero-lede">
            See where a conversation went. Collapse noise, focus a thread, search the live map, and jump back to the exact message while ChatGPT stays native.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#install">Install from source</a>
            <a class="button button-secondary" href={repoUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.94a9.3 9.3 0 0 1 2.5.35c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
              GitHub
            </a>
          </div>
          <p class="hero-status">Early development · install from source</p>
        </div>

        <div class="hero-product" aria-label="Product model showing a conversation map beside native ChatGPT">
          <div class="browser-frame">
            <div class="browser-chrome">
              <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="address-bar"><span class="lock-dot"></span> chatgpt.com</div>
              <div class="chrome-spacer"></div>
            </div>
            <div class="browser-body">
              <aside class="mock-side-panel">
                <div class="mock-appbar">
                  <div class="mock-brand"><span class="mock-brand-dot"></span> Chatspace</div>
                  <span class="mock-kbd">⌘K</span>
                </div>
                <div class="mock-conversation-map">
                  <div class="mock-map-header"><span>Conversation map</span><small>42 turns · live</small></div>
                  <div class="mock-map-canvas">
                    <div class="mock-map-edge edge-one"></div>
                    <div class="mock-map-edge edge-two"></div>
                    <div class="mock-map-edge edge-three"></div>
                    <div class="mock-map-node node-root"><strong>Project architecture</strong><small>Initial direction</small></div>
                    <div class="mock-map-node node-database"><strong>Database schema</strong><small>8 turns</small></div>
                    <div class="mock-map-node node-api"><strong>API design</strong><small>12 turns</small></div>
                    <div class="mock-map-node node-selected"><strong>Redis caching</strong><small>Go to source ↗</small></div>
                  </div>
                </div>
              </aside>
              <section class="mock-provider" aria-label="Native ChatGPT remains the main page">
                <div class="provider-top"><span class="provider-wordmark">ChatGPT</span><span class="provider-account"></span></div>
                <div class="provider-thread">
                  <div class="provider-message user"><span></span><span></span></div>
                  <div class="provider-message assistant"><i></i><div><span></span><span></span><span></span><span></span></div></div>
                  <div class="provider-message user second"><span></span></div>
                  <div class="provider-message assistant"><i></i><div><span></span><span></span><span></span></div></div>
                </div>
                <div class="provider-composer"><span>Ask anything</span><i></i></div>
                <div class="provider-label">Native ChatGPT</div>
              </section>
            </div>
          </div>
          <div class="product-caption">
            <span><i class="caption-dot accent"></i> Chatspace Side Panel</span>
            <span><i class="caption-dot neutral"></i> Native ChatGPT</span>
          </div>
        </div>
      </section>

      <section class="product-section section" id="features" aria-labelledby="features-title">
        <div class="section-heading narrow-heading">
          <span class="section-kicker">Features</span>
          <h2 id="features-title">See the structure of a conversation you already use</h2>
          <p>A local map for long discussions, with native ChatGPT still owning the actual conversation.</p>
        </div>

        <div class="feature-stage feature-stage-conversation">
          <div class="feature-copy">
            <span class="feature-index">Graph</span>
            <h3>Turn a long thread into a spatial map.</h3>
            <p>Chatspace groups rendered prompts and responses into compact turn nodes so the shape of a discussion is visible at a glance.</p>
            <ul class="feature-list">
              <li>Turn-first structure</li>
              <li>Search and focus</li>
              <li>Stable source anchors</li>
            </ul>
          </div>
          <div class="graph-demo" aria-hidden="true">
            <div class="graph-toolbar"><span>Conversation graph</span><div><i></i><i></i><i></i></div></div>
            <svg class="graph-canvas" viewBox="0 0 620 390" fill="none" preserveAspectRatio="xMidYMid meet">
              <path class="graph-edge reference" d="M119 196C185 196 205 112 273 112" />
              <path class="graph-edge reference" d="M119 196C185 196 203 274 273 274" />
              <path class="graph-edge reference" d="M348 112C414 112 420 193 492 193" />
              <path class="graph-edge reference" d="M348 274C416 274 420 193 492 193" />
              <g class="graph-node conversation"><rect x="48" y="166" width="142" height="60" rx="12" /><circle cx="72" cy="196" r="6" /><text x="88" y="192">Conversation</text><text class="node-meta" x="88" y="208">42 turns</text></g>
              <g class="graph-node"><rect x="246" y="81" width="152" height="62" rx="12" /><circle cx="270" cy="112" r="6" /><text x="286" y="108">Database schema</text><text class="node-meta" x="286" y="124">turn cluster</text></g>
              <g class="graph-node"><rect x="246" y="243" width="152" height="62" rx="12" /><circle cx="270" cy="274" r="6" /><text x="286" y="270">API design</text><text class="node-meta" x="286" y="286">turn cluster</text></g>
              <g class="graph-node selected"><rect x="464" y="160" width="128" height="66" rx="12" /><circle cx="488" cy="193" r="6" /><text x="504" y="189">Redis caching</text><text class="node-meta" x="504" y="205">source anchor</text></g>
            </svg>
            <div class="graph-legend"><span><i class="legend-reference"></i> Conversation sequence</span></div>
          </div>
        </div>

        <div class="feature-stage feature-stage-graph">
          <div class="graph-demo" aria-hidden="true">
            <div class="graph-toolbar"><span>Graph</span><div><i></i><i></i><i></i></div></div>
            <svg class="graph-canvas" viewBox="0 0 620 390" fill="none" preserveAspectRatio="xMidYMid meet">
              <path class="graph-edge reference" d="M119 196C185 196 205 112 273 112" />
              <path class="graph-edge reference" d="M119 196C185 196 203 274 273 274" />
              <path class="graph-edge reference" d="M348 112C414 112 420 193 492 193" />
              <path class="graph-edge reference" d="M348 274C416 274 420 193 492 193" />
              <g class="graph-node conversation"><rect x="48" y="166" width="142" height="60" rx="12" /><circle cx="72" cy="196" r="6" /><text x="88" y="192">Conversation</text><text class="node-meta" x="88" y="208">42 turns</text></g>
              <g class="graph-node"><rect x="246" y="81" width="152" height="62" rx="12" /><circle cx="270" cy="112" r="6" /><text x="286" y="108">Database schema</text><text class="node-meta" x="286" y="124">turn cluster</text></g>
              <g class="graph-node"><rect x="246" y="243" width="152" height="62" rx="12" /><circle cx="270" cy="274" r="6" /><text x="286" y="270">API design</text><text class="node-meta" x="286" y="286">turn cluster</text></g>
              <g class="graph-node selected"><rect x="464" y="160" width="128" height="66" rx="12" /><circle cx="488" cy="193" r="6" /><text x="504" y="189">Redis caching</text><text class="node-meta" x="504" y="205">source anchor</text></g>
            </svg>
            <div class="graph-legend"><span><i class="legend-reference"></i> Conversation sequence</span></div>
          </div>
          <div class="feature-copy">
            <span class="feature-index">Source navigation</span>
            <h3>Jump from the map to the exact native message.</h3>
            <p>Select a turn and Chatspace scrolls the matching rendered element into view with a temporary, non-destructive highlight.</p>
            <ul class="feature-list">
              <li>Go to source</li>
              <li>Bidirectional scroll context</li>
              <li>No private API or network interception</li>
            </ul>
          </div>
        </div>

        <div class="feature-stage feature-stage-privacy">
          <div class="feature-copy">
            <span class="feature-index">Privacy</span>
            <h3>The live map stays ephemeral by default.</h3>
            <p>Rendered conversation text stays in memory. Only explicit pins and annotations are saved as Chatspace-owned metadata.</p>
            <ul class="feature-list">
              <li>Read-only rendered DOM</li>
              <li>Existing host permission</li>
              <li>No transcript persistence</li>
            </ul>
          </div>
          <div class="privacy-demo" aria-hidden="true">
            <span>Rendered ChatGPT DOM</span><strong>→</strong><span>Ephemeral map</span><strong>→</strong><span>Exact source navigation</span>
          </div>
        </div>
      </section>

      <section class="workflow-section section" aria-labelledby="workflow-title">
        <div class="section-heading narrow-heading">
          <h2 id="workflow-title">A simple daily workflow</h2>
          <p>Open ChatGPT, read the map, then return to the source message when you need it.</p>
        </div>
        <ol class="workflow-list">
          {steps.map(([number, title, copy]) => (
            <li>
              <span class="workflow-number">{number}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="trust-section section" id="boundaries" aria-labelledby="trust-title">
        <div class="trust-panel">
          <div class="trust-copy">
            <h2 id="trust-title">What stays local, and what stays with ChatGPT</h2>
            <p>Local-first is a boundary, not a badge. Chatspace reads the rendered conversation only through one read-only bridge; ChatGPT remains the runtime and content owner.</p>
            <div class="trust-links">
              <a href={privacyUrl} target="_blank" rel="noreferrer">Privacy <span>↗</span></a>
              <a href={securityUrl} target="_blank" rel="noreferrer">Security <span>↗</span></a>
            </div>
          </div>
          <div class="boundary-table" role="table" aria-label="Chatspace data and access boundaries">
            <div class="boundary-row boundary-head" role="row"><span role="columnheader">Boundary</span><span role="columnheader">Current behavior</span></div>
            <div class="boundary-row" role="row"><span role="cell">Conversation content</span><strong role="cell">ChatGPT</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Graph annotations</span><strong role="cell">Explicit / local</strong></div>
            <div class="boundary-row" role="row"><span role="cell">ChatGPT navigation</span><strong role="cell">Validated URL / tab</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Rendered conversation map</span><strong role="cell">Ephemeral / read-only</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Conversation text</span><strong role="cell">Not persisted</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Cloud account</span><strong role="cell">Not required</strong></div>
          </div>
        </div>
      </section>

      <section class="install-section section" id="install" aria-labelledby="install-title">
        <div class="install-grid">
          <div class="install-copy">
            <h2 id="install-title">Install from source</h2>
            <p>Chatspace is in early development and is not a store-ready release. Clone the repository, build the Chromium extension, and load the generated output locally.</p>
            <a class="button button-primary" href={repoUrl} target="_blank" rel="noreferrer">Open GitHub <span>↗</span></a>
            <p class="license-note">Source available on GitHub. No open-source license has been declared yet.</p>
          </div>
          <div class="code-window">
            <div class="code-titlebar"><span>Install from source</span><div><i></i><i></i><i></i></div></div>
            <pre><code><span class="code-comment"># Requirements: Node 22.12+ and pnpm 11.23.0</span>
<span class="code-prompt">$</span> git clone https://github.com/howlil/chatspace.git
<span class="code-prompt">$</span> cd chatspace
<span class="code-prompt">$</span> pnpm install --frozen-lockfile
<span class="code-prompt">$</span> pnpm build

<span class="code-comment"># Then load the generated extension from .output/
# using Chromium's “Load unpacked”.</span></code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand"><span class="brand-mark mini" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" /></svg></span><span>Chatspace</span></div>
      <p>Spatial conversation navigation beside native ChatGPT.</p>
      <nav aria-label="Footer navigation">
        <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={privacyUrl} target="_blank" rel="noreferrer">Privacy</a>
        <a href={securityUrl} target="_blank" rel="noreferrer">Security</a>
      </nav>
    </footer>
  </div>
</BaseLayout>

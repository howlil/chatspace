---
import BaseLayout from '../layouts/BaseLayout.astro';

const repoUrl = 'https://github.com/howlil/chatspace';
const privacyUrl = `${repoUrl}/blob/master/PRIVACY.md`;
const securityUrl = `${repoUrl}/blob/master/SECURITY.md`;

const steps = [
  ['01', 'Save a ChatGPT conversation reference', 'Keep a local reference to a supported conversation you want to return to.'],
  ['02', 'Write or link a Markdown note', 'Add your own notes, tags, and links beside the saved conversation.'],
  ['03', 'Return through Explorer or Graph', 'Navigate the local workspace without replacing the native ChatGPT conversation surface.'],
];
---

<BaseLayout
  title="Chatspace — organize ChatGPT work without replacing ChatGPT"
  description="A local-first Chromium Side Panel for saved ChatGPT conversation references, Markdown notes, workspace navigation, and graph relationships."
>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Chatspace home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" />
          </svg>
        </span>
        <span>Chatspace</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#features">Features</a>
        <a href="#boundaries">Boundaries</a>
        <a href="#install">Install</a>
      </nav>

      <div class="header-actions">
        <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Use light theme" title="Use light theme">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5" />
            <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3 3.9 3.9M20.1 20.1l-1.4-1.4M18.7 5.3l1.4-1.4M3.9 20.1l1.4-1.4" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M20 15.2A8.3 8.3 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z" />
          </svg>
        </button>
        <a class="header-repo" href={repoUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.94a9.3 9.3 0 0 1 2.5.35c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> Chromium Side Panel · local-first</div>
          <h1 id="hero-title">Organize ChatGPT work without replacing ChatGPT.</h1>
          <p class="hero-lede">
            Chatspace keeps saved conversation references, Markdown notes, workspace navigation, and graph relationships in a local Side Panel. ChatGPT stays native.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#install">Install from source</a>
            <a class="button button-secondary" href={repoUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.72.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.94a9.3 9.3 0 0 1 2.5.35c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.8 0 .27.18.59.69.49A10.24 10.24 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" /></svg>
              GitHub
            </a>
          </div>
          <p class="hero-status">Early development · install from source</p>
        </div>

        <div class="hero-product" aria-label="Product model showing Chatspace beside native ChatGPT">
          <div class="browser-frame">
            <div class="browser-chrome">
              <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
              <div class="address-bar"><span class="lock-dot"></span> chatgpt.com</div>
              <div class="chrome-spacer"></div>
            </div>
            <div class="browser-body">
              <aside class="mock-side-panel">
                <div class="mock-appbar">
                  <div class="mock-brand"><span class="mock-brand-dot"></span> Chatspace</div>
                  <span class="mock-kbd">⌘K</span>
                </div>
                <div class="mock-workspace">
                  <div class="mock-explorer">
                    <div class="mock-search"><span></span><em>Search workspace</em></div>
                    <div class="mock-section-label">Pinned</div>
                    <div class="mock-tree-row active"><i class="tree-chat"></i><span>Architecture notes</span></div>
                    <div class="mock-tree-row"><i class="tree-chat"></i><span>Graph navigation</span></div>
                    <div class="mock-section-label with-rule">Workspace</div>
                    <div class="mock-tree-row folder"><i class="tree-folder"></i><span>Research</span><small>3</small></div>
                    <div class="mock-tree-row nested"><i class="tree-note"></i><span>Local-first design</span></div>
                    <div class="mock-tree-row folder"><i class="tree-folder"></i><span>Build</span><small>2</small></div>
                  </div>
                  <div class="mock-workbench">
                    <div class="mock-tabs">
                      <div class="mock-tab active">Local-first design</div>
                      <div class="mock-tab">Graph</div>
                    </div>
                    <div class="mock-editor">
                      <div class="editor-kicker">NOTE</div>
                      <div class="editor-title">Local-first design</div>
                      <div class="editor-meta"><span>#architecture</span><span>#privacy</span></div>
                      <div class="editor-rule"></div>
                      <div class="editor-line wide"></div>
                      <div class="editor-line mid"></div>
                      <div class="editor-line short"></div>
                      <div class="editor-callout">
                        <span class="callout-icon">↗</span>
                        <div><b>Linked conversation</b><small>Architecture notes</small></div>
                      </div>
                      <div class="editor-line wide muted"></div>
                      <div class="editor-line mid muted"></div>
                    </div>
                  </div>
                </div>
              </aside>
              <section class="mock-provider" aria-label="Native ChatGPT remains the main page">
                <div class="provider-top"><span class="provider-wordmark">ChatGPT</span><span class="provider-account"></span></div>
                <div class="provider-thread">
                  <div class="provider-message user"><span></span><span></span></div>
                  <div class="provider-message assistant"><i></i><div><span></span><span></span><span></span><span></span></div></div>
                  <div class="provider-message user second"><span></span></div>
                  <div class="provider-message assistant"><i></i><div><span></span><span></span><span></span></div></div>
                </div>
                <div class="provider-composer"><span>Ask anything</span><i></i></div>
                <div class="provider-label">Native ChatGPT</div>
              </section>
            </div>
          </div>
          <div class="product-caption">
            <span><i class="caption-dot accent"></i> Chatspace Side Panel</span>
            <span><i class="caption-dot neutral"></i> Native ChatGPT</span>
          </div>
        </div>
      </section>

      <section class="product-section section" id="features" aria-labelledby="features-title">
        <div class="section-heading narrow-heading">
          <span class="section-kicker">Features</span>
          <h2 id="features-title">What Chatspace adds beside ChatGPT</h2>
          <p>Local structure for conversations you already use: notes, navigation, and explicit relationships.</p>
        </div>

        <div class="feature-stage feature-stage-notes">
          <div class="feature-copy">
            <span class="feature-index">Notes</span>
            <h3>Write Markdown notes beside saved conversations.</h3>
            <p>Add tags, link a note to saved chats, and return to related local context without importing ChatGPT conversation content.</p>
            <ul class="feature-list">
              <li>Markdown Edit / Preview</li>
              <li>Tags and linked chat references</li>
              <li>Related-local navigation</li>
            </ul>
          </div>
          <div class="note-demo" aria-hidden="true">
            <div class="demo-toolbar"><span>local-first-design.md</span><div><i></i><i></i></div></div>
            <div class="demo-note-body">
              <span class="demo-overline">ARCHITECTURE NOTE</span>
              <h4>Local-first design</h4>
              <div class="demo-tags"><span>architecture</span><span>privacy</span><span>workspace</span></div>
              <p>Keep notes, links, and relationships in the workspace while ChatGPT remains the conversation surface.</p>
              <div class="demo-quote"><span>ChatGPT link</span><strong>Validated conversation URL</strong></div>
              <div class="demo-linked"><i>↗</i><span><small>LINKED CHAT</small>Architecture notes</span><b>Open</b></div>
            </div>
          </div>
        </div>

        <div class="feature-stage feature-stage-graph">
          <div class="graph-demo" aria-hidden="true">
            <div class="graph-toolbar"><span>Graph</span><div><i></i><i></i><i></i></div></div>
            <svg class="graph-canvas" viewBox="0 0 620 390" fill="none" preserveAspectRatio="xMidYMid meet">
              <path class="graph-edge reference" d="M119 196C185 196 205 112 273 112" />
              <path class="graph-edge reference" d="M119 196C185 196 203 274 273 274" />
              <path class="graph-edge manual" d="M348 112C414 112 420 193 492 193" />
              <path class="graph-edge manual" d="M348 274C416 274 420 193 492 193" />
              <g class="graph-node workspace"><rect x="48" y="166" width="142" height="60" rx="12" /><circle cx="72" cy="196" r="6" /><text x="88" y="192">Workspace</text><text class="node-meta" x="88" y="208">local root</text></g>
              <g class="graph-node note"><rect x="246" y="81" width="152" height="62" rx="12" /><circle cx="270" cy="112" r="6" /><text x="286" y="108">Local-first design</text><text class="node-meta" x="286" y="124">note</text></g>
              <g class="graph-node chat"><rect x="246" y="243" width="152" height="62" rx="12" /><circle cx="270" cy="274" r="6" /><text x="286" y="270">Architecture notes</text><text class="node-meta" x="286" y="286">chat reference</text></g>
              <g class="graph-node selected"><rect x="464" y="160" width="128" height="66" rx="12" /><circle cx="488" cy="193" r="6" /><text x="504" y="189">Privacy model</text><text class="node-meta" x="504" y="205">note</text></g>
            </svg>
            <div class="graph-legend"><span><i class="legend-reference"></i> Reference</span><span><i class="legend-manual"></i> Manual relation</span></div>
          </div>
          <div class="feature-copy">
            <span class="feature-index">Graph</span>
            <h3>Navigate explicit relationships between notes and saved chats.</h3>
            <p>Graph is built from local workspace state. Manual relationships stay explicit and layout remains derived.</p>
            <ul class="feature-list">
              <li>Pan, zoom, fit, search, and focus</li>
              <li>Manual relationships stay explicit</li>
              <li>No AI-generated graph edges</li>
            </ul>
          </div>
        </div>

        <div class="feature-stage feature-stage-sync">
          <div class="feature-copy">
            <span class="feature-index">Markdown Sync</span>
            <h3>Your notes can become ordinary files.</h3>
            <p>Choose a local folder and write the active note beneath <code>Chatspace/</code> when you want to. Sync is manual and one-way.</p>
            <ul class="feature-list">
              <li>Direct selected-folder access</li>
              <li>Manual one-way write</li>
              <li>No companion server</li>
            </ul>
          </div>
          <div class="sync-demo" aria-hidden="true">
            <div class="sync-path"><span>Selected folder</span><strong>Knowledge Vault</strong><i>Connected</i></div>
            <div class="sync-flow">
              <div class="sync-source"><small>ACTIVE NOTE</small><b>Local-first design</b><span>1.8 KB Markdown</span></div>
              <div class="sync-arrow"><span>Manual sync</span><i>→</i></div>
              <div class="sync-target"><small>LOCAL FILE</small><b>Chatspace/local-first-design.md</b><span>Written on request</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="workflow-section section" aria-labelledby="workflow-title">
        <div class="section-heading narrow-heading">
          <h2 id="workflow-title">A simple daily workflow</h2>
          <p>Save a conversation reference, add your own context, then return through the workspace when you need it.</p>
        </div>
        <ol class="workflow-list">
          {steps.map(([number, title, copy]) => (
            <li>
              <span class="workflow-number">{number}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="trust-section section" id="boundaries" aria-labelledby="trust-title">
        <div class="trust-panel">
          <div class="trust-copy">
            <h2 id="trust-title">What stays local, and what stays with ChatGPT</h2>
            <p>Local-first is a boundary, not a badge. Chatspace keeps workspace ownership explicit and limits ChatGPT integration to supported URL and tab navigation.</p>
            <div class="trust-links">
              <a href={privacyUrl} target="_blank" rel="noreferrer">Privacy <span>↗</span></a>
              <a href={securityUrl} target="_blank" rel="noreferrer">Security <span>↗</span></a>
            </div>
          </div>
          <div class="boundary-table" role="table" aria-label="Chatspace data and access boundaries">
            <div class="boundary-row boundary-head" role="row"><span role="columnheader">Boundary</span><span role="columnheader">Current behavior</span></div>
            <div class="boundary-row" role="row"><span role="cell">Conversation content</span><strong role="cell">ChatGPT</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Workspace state</span><strong role="cell">Browser-local</strong></div>
            <div class="boundary-row" role="row"><span role="cell">ChatGPT navigation</span><strong role="cell">Validated URL / tab</strong></div>
            <div class="boundary-row" role="row"><span role="cell">ChatGPT page scraping</span><strong role="cell">Not used</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Markdown sync</span><strong role="cell">Manual / one-way</strong></div>
            <div class="boundary-row" role="row"><span role="cell">Cloud account</span><strong role="cell">Not required</strong></div>
          </div>
        </div>
      </section>

      <section class="install-section section" id="install" aria-labelledby="install-title">
        <div class="install-grid">
          <div class="install-copy">
            <h2 id="install-title">Install from source</h2>
            <p>Chatspace is in early development and is not a store-ready release. Clone the repository, build the Chromium extension, and load the generated output locally.</p>
            <a class="button button-primary" href={repoUrl} target="_blank" rel="noreferrer">Open GitHub <span>↗</span></a>
            <p class="license-note">Source available on GitHub. No open-source license has been declared yet.</p>
          </div>
          <div class="code-window">
            <div class="code-titlebar"><span>Install from source</span><div><i></i><i></i><i></i></div></div>
            <pre><code><span class="code-comment"># Requirements: Node 22.12+ and pnpm 11.23.0</span>
<span class="code-prompt">$</span> git clone https://github.com/howlil/chatspace.git
<span class="code-prompt">$</span> cd chatspace
<span class="code-prompt">$</span> pnpm install --frozen-lockfile
<span class="code-prompt">$</span> pnpm build

<span class="code-comment"># Then load the generated extension from .output/
# using Chromium's “Load unpacked”.</span></code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand"><span class="brand-mark mini" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v5a3.5 3.5 0 0 1-3.5 3.5H12l-4.5 4v-4A3.5 3.5 0 0 1 5 12.5v-5Z" /></svg></span><span>Chatspace</span></div>
      <p>Saved chats, Markdown notes, and graph navigation beside native ChatGPT.</p>
      <nav aria-label="Footer navigation">
        <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={privacyUrl} target="_blank" rel="noreferrer">Privacy</a>
        <a href={securityUrl} target="_blank" rel="noreferrer">Security</a>
      </nav>
    </footer>
  </div>
</BaseLayout>